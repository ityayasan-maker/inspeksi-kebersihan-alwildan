Options -Indexes
RewriteEngine On

# Jika request masuk dengan awalan public/, lepaskan public/ agar file statis langsung terbaca
RewriteRule ^public/(.*)$ $1 [L,NC]

# Izinkan akses langsung ke file & folder nyata (css, js, uploads, gambar)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Semua request lain diarahkan ke index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Blokir akses ke file sensitif
<FilesMatch "\.(sql|log|env|ini|sh|bat)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
